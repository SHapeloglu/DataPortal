# ── DataPortal Ortam Değişkenleri ──────────────────────────────────────────
# Bu dosyayı .env olarak kopyalayın:  cp .env.example .env

# Flask oturum güvenlik anahtarı (ZORUNLU — production'da değiştirin)
# Üretmek için: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=BURAYA_GUCLU_RASTGELE_BIR_DEGER_YAZIN

# Debug modu — production'da false olmalı
FLASK_DEBUG=false

# HTTPS kullanıyorsanız true yapın (SESSION_COOKIE_SECURE)
HTTPS=false

# ── MySQL (Docker ile kullanım için) ───────────────────────────────────────
DB_ROOT_PASSWORD=rootpass_degistir
DB_NAME=dataportal
DB_USER=dpuser
DB_PASSWORD=dppass_degistir

# ── Excel dosya saklama dizini ─────────────────────────────────────────────
# Docker kullanımında /app/excel_store (volume ile eşlenir)
# Lokal kullanımda istediğiniz bir dizin
EXCEL_STORE_PATH=excel_store
