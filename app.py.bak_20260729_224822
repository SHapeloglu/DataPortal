        try:
            import openpyxl
            wb     = openpyxl.load_workbook(filepath, read_only=True, data_only=True)
            sheets = wb.sheetnames
            wb.close()
            df = pd.read_excel(filepath, sheet_name=sheet_idx,
                               header=header_row - 1, dtype=str).fillna('')
